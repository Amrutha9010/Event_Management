# UPI details for manual payment verification
EVENTORA_UPI_ID=your-merchant-upi-id@bank
EVENTORA_UPI_PAYEE_NAME=Eventora
PAYMENT_PROOF_STORAGE_DIR=./uploads/payment-proofs

# Optional SMTP configuration for booking/payment status emails
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_FROM=no-reply@your-domain.example
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=use-an-app-password-not-your-account-password
